generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum SubscriptionTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum AlertFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id                    String              @id @default(cuid())
  firebaseId            String
  autoplay              Boolean             @default(false)
  genres                String[]            @default(["all"])
  yearFrom              Int                 @default(1960)
  yearTo                Int                 @default(dbgenerated("extract(year from now())::int"))
  curatedMode           Boolean             @default(false)
  swipeMode             Boolean             @default(true)
  isAnonymous           Boolean             @default(false)
  email                 String?
  genreAlerts           String[]            @default([])
  genreAlertFrequency   AlertFrequency      @default(WEEKLY)
  genreEmailsEnabled    Boolean             @default(false)
  lastActiveAt          DateTime            @default(now())
  subscriptionTier      SubscriptionTier    @default(FREE)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  subscriptionStatus    SubscriptionStatus?
  subscriptionExpiresAt DateTime?
  spotifyAccessToken    String?
  spotifyRefreshToken   String?
  spotifyTokenExpiresAt DateTime?
  Review                Review[]
}

model Review {
  id                 String    @id @default(cuid())
  currentReviewStep  Int
  furthestReviewStep Int
  Track              Track     @relation(fields: [trackId], references: [id])
  trackId            String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  purchased          Boolean   @default(false)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([userId, trackId])
}

model Track {
  id            String    @id @default(cuid())
  platform      String
  platformId    String    @unique
  purchaseUrl   String
  artist        String
  releaseTitle  String
  genre         String
  title         String
  thumbnail     String
  releaseYear   Int
  releaseDate   String
  deezerTrackId String?
  createdAt     DateTime  @default(now())
  review        Review[]
}
