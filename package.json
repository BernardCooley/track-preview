{
    "name": "phoniquest",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "tsc": "tsc --noEmit",
        "postinstall": "prisma generate && chakra typegen ./ChakraTheme.ts",
        "migratelocal": "npx prisma migrate dev",
        "migrateprod": "dotenv -e .env.production -- npx prisma migrate deploy",
        "scrapejuno": "node scraping_tracks/scrapejuno.js",
        "scrape7digital": "node scraping_tracks/scrape7digital.js",
        "scrape7digitaltracks": "node scraping_tracks/scrape7digitaltracks.js",
        "addslugtotracks": "node scraping_tracks/addslugtotracks.js",
        "searchTracksSpotify": "node scraping_tracks/searchTracksSpotify.js",
        "searchTracksDeezer": "node scraping_tracks/searchTracksDeezer.js",
        "test": "vitest",
        "test:run": "vitest run",
        "runlocaldb": "docker run --rm -p 5432:5432 -e POSTGRES_HOST_AUTH_METHOD=trust postgres",
        "setup:local": "colima start && docker run --rm -d -p 5432:5432 -e POSTGRES_HOST_AUTH_METHOD=trust postgres && sleep 3 && npx prisma db push && npx prisma db seed && npx prisma studio"
    },
    "dependencies": {
        "@amplitude/experiment-js-client": "^1.24.0",
        "@amplitude/experiment-node-server": "^1.13.6",
        "@amplitude/unified": "^1.2.4",
        "@chakra-ui/react": "3.38.0",
        "@emotion/react": "11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/allerta-stencil": "5.3.0",
        "@hookform/resolvers": "3.10.0",
        "@mui/icons-material": "5.18.0",
        "@mui/material": "5.18.0",
        "@prisma/client": "5.22.0",
        "@sentry/nextjs": "^11.16.0",
        "@vercel/postgres": "0.10.0",
        "aws-amplify": "6.22.2",
        "axios": "1.21.1",
        "firebase": "10.12.5",
        "firebase-admin": "^14.5.1",
        "framer-motion": "10.18.0",
        "next": "16.4.6",
        "node-fetch": "3.3.2",
        "node-itunes-search": "1.2.3",
        "nodemailer": "^10.6.0",
        "puppeteer-extra": "^3.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "rc-progress": "3.5.1",
        "react": "18.3.1",
        "react-device-detect": "2.2.3",
        "react-dom": "18.3.1",
        "react-h5-audio-player": "3.9.0",
        "react-hook-form": "7.92.0",
        "react-icons": "5.7.0",
        "react-range-slider-input": "3.3.5",
        "serwist": "^9.5.15",
        "spotify-web-api-node": "5.0.2",
        "stripe": "^23.2.0",
        "usehooks-ts": "2.16.0",
        "uuid": "9.0.1",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@aws-amplify/backend": "0.15.1",
        "@aws-amplify/backend-cli": "0.16.0",
        "@chakra-ui/cli": "^3.38.0",
        "@serwist/turbopack": "^9.5.15",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.12",
        "@types/node": "20.19.43",
        "@types/nodemailer": "^8.0.2",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "@types/uuid": "9.0.8",
        "@vitejs/plugin-react": "^6.3.0",
        "dotenv-cli": "^11.1.0",
        "encoding": "0.1.14",
        "esbuild": "^0.28.2",
        "eslint": "8.57.1",
        "eslint-config-next": "15.5.29",
        "jsdom": "^31.0.1",
        "msw": "^3.0.7",
        "prisma": "5.22.0",
        "puppeteer": "21.11.0",
        "puppeteer-extra": "3.3.6",
        "puppeteer-extra-plugin-stealth": "2.11.2",
        "typescript": "5.9.3",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "overrides": {
        "msw": {
            "graphql": "15.8.0"
        },
        "vitest": {
            "@types/node": "$@types/node"
        },
        "jwks-rsa": {
            "jose": "5.10.0"
        }
    },
    "prisma": {
        "seed": "node prisma/seed.js",
        "schema": "./prisma/schema.prisma"
    }
}
